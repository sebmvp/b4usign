# Local development only. The database is the Docker PostGIS instance on port 5433.
# Port 5432 is left alone because another Postgres already listens there.
DATABASE_URL=postgresql://bys:bys@localhost:5433/before_you_sign

# Read-only engineering page. Turn this off before any public deploy.
BYS_EXPOSE_ENGINEERING=1

# Optional. Ask This Property works without a model.
# OLLAMA_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=qwen3.5:2b
